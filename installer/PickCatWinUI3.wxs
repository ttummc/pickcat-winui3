<?xml version="1.0" encoding="utf-8"?>
<!--
  PickCat WinUI 3 — Windows Installer package.

  perUser scope: installs under %LOCALAPPDATA%\Programs, no UAC prompt, and still
  produces a proper entry in Settings > Apps (with an uninstaller) plus a Start
  menu shortcut.

  Build: desktop\build-installer.ps1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
      Name="PickCat WinUI 3"
      Manufacturer="PickCat WinUI 3 contributors"
      Version="1.0.0"
      UpgradeCode="6B2E0C55-71A4-4F3B-9C7D-2A8E5D41C9F3"
      Scope="perUser"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation Description="PickCat WinUI 3 — a Windows 11 style client for PickCat" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of PickCat WinUI 3 is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- %LOCALAPPDATA%\Programs\PickCat WinUI 3 -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PickCat WinUI 3" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="PickCat WinUI 3" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="PickCat WinUI 3" Level="1">


      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="CleanInstallFolder" />
      <ComponentRef Id="RemoveUserData" />
    </Feature>

    <!-- Add/Remove Programs metadata -->
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Icon Id="AppIcon" SourceFile="$(var.PublishDir)\Assets\app.ico" />

    <!-- 卸载时删除用户数据：WebView2 profile 里存着登录 Cookie。
         RemoveFolderEx 依赖的属性无法解析（WIX1077），改为直接递归删除。 -->
    <CustomAction Id="PurgeUserData"
                  Directory="LocalAppDataFolder"
                  ExeCommand="cmd.exe /c taskkill /f /t /im PickCatWinUI3.exe &gt;nul 2&gt;&amp;1 &amp; rmdir /s /q &quot;PickCatWinUI3&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />
    <!-- RemoveFolderEx 在这个包里同样失败（1613/1603），安装目录也会留下，
         所以一并处理。 -->
    <CustomAction Id="PurgeInstallFolder"
                  Directory="LocalAppDataFolder"
                  ExeCommand="cmd.exe /c rmdir /s /q &quot;Programs\PickCat WinUI 3&quot;"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />
    <!-- The MSI's own shortcut and registry removal does not take effect in this
         per-user package, so the shortcuts and our registry markers go too. -->
    <CustomAction Id="PurgeShortcuts"
                  Directory="LocalAppDataFolder"
                  ExeCommand="cmd.exe /c rmdir /s /q &quot;%APPDATA%\Microsoft\Windows\Start Menu\Programs\PickCat WinUI 3&quot; &amp; del /q &quot;%USERPROFILE%\Desktop\PickCat WinUI 3.lnk&quot; &amp; reg delete &quot;HKCU\Software\PickCat&quot; /f &gt;nul 2&gt;&amp;1"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />
    <!-- A running instance locks the binary; a pre-2.0 install also ran a bundled
         kernel from dsh\ that locks its own files. Both must go, or the upgrade
         fails with 2318 "cannot replace <file>". Only copies under this install
         folder are targeted, so a separately installed DeepSeek Harness is left
         alone. -->
    <CustomAction Id="CloseRunningApp"
                  Directory="LocalAppDataFolder"
                  ExeCommand="cmd.exe /c taskkill /f /im PickCatWinUI3.exe &gt;nul 2&gt;&amp;1 &amp; powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-Process -Name &apos;DeepSeek Harness&apos; -ErrorAction SilentlyContinue | Where-Object { $_.Path -like &apos;*PickCat WinUI 3\dsh*&apos; } | Stop-Process -Force -ErrorAction SilentlyContinue&quot;"
                  Execute="immediate"
                  Return="ignore" />
    <!-- 2.0 removed the bundled kernel. Upgrading would otherwise leave its ~1.4 GB
         behind, because Windows Installer only removes files it wrote itself. -->
    <CustomAction Id="PurgeLegacyKernel"
                  Directory="LocalAppDataFolder"
                  ExeCommand="cmd.exe /c if exist &quot;Programs\PickCat WinUI 3\dsh&quot; rmdir /s /q &quot;Programs\PickCat WinUI 3\dsh&quot;"
                  Execute="immediate"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CloseRunningApp" Before="InstallValidate" />
      <Custom Action="PurgeLegacyKernel" After="CloseRunningApp" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PurgeUserData" After="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PurgeInstallFolder" After="PurgeUserData" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="PurgeShortcuts" After="PurgeInstallFolder" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>

  <Fragment>
    <!-- Everything the self-contained publish produced. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="..\desktop\publish\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="CleanInstallFolder" Directory="INSTALLFOLDER" Guid="E7A2C5D8-4B31-4F60-9D85-1C3A6B7E2F04">
      <!-- The app writes a WebView2 profile (and logs) at runtime; those files are not
           tracked by the MSI, so purge the whole folder on uninstall. -->
      <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\PickCat\WinUI3" Name="Cleanup" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <!-- %LOCALAPPDATA%\PickCatWinUI3 holds the WebView2 profile and logs; it lives
         outside the install folder, so the uninstaller removes it explicitly. -->
    <DirectoryRef Id="LocalAppDataFolder">
      <Directory Id="UserDataFolder" Name="PickCatWinUI3">
        <Component Id="RemoveUserData" Guid="B9F41D27-8C63-4A0E-93B7-6E2D5A8C1F48">
          <util:RemoveFolderEx On="uninstall" Property="USERDATAFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\PickCat\WinUI3" Name="UserData" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </DirectoryRef>
    <Property Id="USERDATAFOLDER" Value="[UserDataFolder]" />
  </Fragment>


  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="A1C4F7B2-3D68-4E15-8B90-7C2F5E9A4D61">
      <Shortcut Id="AppShortcut"
                Name="PickCat WinUI 3"
                Description="PickCat, rebuilt as a Windows 11 style app"
                Target="[INSTALLFOLDER]PickCatWinUI3.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\PickCat\WinUI3" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="C3D8B1E4-5A27-4F96-A0B3-9E6D2C7F8A15">
      <Shortcut Id="DesktopAppShortcut"
                Name="PickCat WinUI 3"
                Target="[INSTALLFOLDER]PickCatWinUI3.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\PickCat\WinUI3" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>



</Wix>
