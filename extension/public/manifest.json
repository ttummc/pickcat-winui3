{
  "manifest_version": 3,
  "name": "PickCat WinUI 3（非官方重制）",
  "version": "1.3.1",
  "description": "用 WinUI 3 控件从零重绘 pickcat.dao3.fun 的界面：窗口、导航、右键菜单、Markdown 编辑器全部重写。非官方实现。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/pickcat.png",
    "48": "icons/pickcat.png",
    "128": "icons/pickcat.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "tabs"
  ],
  "host_permissions": [
    "https://pickcat.dao3.fun/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pickcat.dao3.fun/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pickcat.dao3.fun/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*",
        "content.css"
      ],
      "matches": [
        "https://pickcat.dao3.fun/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
