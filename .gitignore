# dependencies
node_modules/

# build output (the release zip is built by CI / `npm run ext:build`)
extension/dist/
/PickCat-WinUI3-extension.zip
# local browser profiles used by the CDP recording tools
.chrome-profile*/
.tmp/
shots/

# recorded video frames (regenerated by tools/record-demo.mjs)
video/frames/
video/seq/
video/thumbs/

# downloaded tooling
vendor/ffmpeg/
vendor/ffmpeg.zip

# secrets / local state
session_cookie.txt
*.log

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# desktop app build output (publish/dist are large, rebuilt by desktop/build-installer.ps1)
desktop/publish/
desktop/dist/
desktop/PickCat.WinUI3/bin/
desktop/PickCat.WinUI3/obj/
desktop/publish/data/

# downloaded site bundle chunks used only for extracting request bodies
research/chunks/
research/.tmp-endpoints.txt

.chrome-orig*/
.chrome-*/

# DSH 插件的分发归档
/releases/dsh-plugin/
